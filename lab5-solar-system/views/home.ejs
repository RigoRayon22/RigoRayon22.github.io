<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lab 5: The Solar System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar.ejs') %>

    <main class="container my-5">
        <div class="row align-items-center home-section">
            <div class="col-md-6">
                <h2>Welcome to the Solar System</h2>
                <p>
                    Explore all eight planets, learn about asteroids and comets, and see NASA's Astronomy Picture of the Day.
                </p>
                <p>
                    Use the navigation menu above to move through the site and discover facts about our solar system.
                </p>
            </div>

            <div class="col-md-6 text-center">
                <% if (image) { %>
                    <img src="<%= image %>" alt="Solar System" class="img-fluid rounded shadow home-image">
                <% } else { %>
                    <p>Image could not be loaded.</p>
                <% } %>
            </div>
        </div>
    </main>

    <footer class="bg-dark text-white text-center p-3 mt-5">
        Created by Rigoberto Rayon
    </footer>
</body>
</html>